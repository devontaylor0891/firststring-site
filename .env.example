# Copy to `.env` and fill in. Consumed by set-env.js during `npm run build`,
# which generates src/environments/environment.prod.ts.
#
# These Firebase values are public by design - they ship in the browser
# bundle. Access control comes from Firestore security rules, not secrecy.
# `.env` is gitignored mainly to keep ADMIN_EMAIL out of this public repo.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Account allowed into /admin. Must match the Firestore rules.
ADMIN_EMAIL=
